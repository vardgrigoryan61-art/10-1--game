--NEXT.ITEM-BOUNDARY
Content-Type: text/html; charset="utf-8"
Content-Location: https://online-bloknot.ru/

<!DOCTYPE html>
<html xmlns:o="urn:schemas-microsoft-com:office:office" 
xmlns:w="urn:schemas-microsoft-com:office:word" 
xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<!--[if gte mso 9]><xml>
 <w:WordDocument>
  <w:View>Print</w:View>
  <w:GrammarState>Clean</w:GrammarState>
  <w:ValidateAgainstSchemas/>
  <w:SaveIfXMLInvalid>false</w:SaveIfXMLInvalid>
  <w:IgnoreMixedContent>false</w:IgnoreMixedContent>
  <w:AlwaysShowPlaceholderText>false</w:AlwaysShowPlaceholderText>
  <w:BrowserLevel>MicrosoftInternetExplorer4</w:BrowserLevel>
 </w:WordDocument>
</xml><![endif]--><!--[if gte mso 9]><xml>
 <w:LatentStyles DefLockedState="false" LatentStyleCount="156">
 </w:LatentStyles>
</xml><![endif]-->
<style>

</style>
</head>
<body><div style="font-family:Calibri,sans-serif;font-size:11pt;"><p>:root {<br>&nbsp; &nbsp; --bg-dark: #0C182B;<br>&nbsp; &nbsp; --card-bg: #132238;<br>&nbsp; &nbsp; --gold: #D4AF37;<br>&nbsp; &nbsp; --terracotta: #B85B35;<br>&nbsp; &nbsp; --text-light: #F5F2EC;<br>}</p><p>body {<br>&nbsp; &nbsp; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;<br>&nbsp; &nbsp; background:var(--bg-dark);mso-highlight:var(--bg-dark);<br>&nbsp; &nbsp; color: var(--text-light);<br>&nbsp; &nbsp; margin: 0;<br>&nbsp; &nbsp; padding: 0;<br>&nbsp; &nbsp; display: flex;<br>&nbsp; &nbsp; flex-direction: column;<br>&nbsp; &nbsp; min-height: 100vh;<br>}</p><p>header {<br>&nbsp; &nbsp; text-align: center;<br>&nbsp; &nbsp; padding: 30px 20px;<br>&nbsp; &nbsp; background: linear-gradient(135deg, #0C182B 0%, #1a3052 100%);<br>&nbsp; &nbsp; border-bottom: 2px solid var(--gold);<br>}</p><p>.logo-badge {<br>&nbsp; &nbsp; display: inline-block;<br>&nbsp; &nbsp; background:var(--terracotta);mso-highlight:var(--terracotta);<br>&nbsp; &nbsp; color: var(--text-light);<br>&nbsp; &nbsp; padding: 6px 16px;<br>&nbsp; &nbsp; border-radius: 20px;<br>&nbsp; &nbsp; font-size: 14px;<br>&nbsp; &nbsp; font-weight: bold;<br>&nbsp; &nbsp; margin-bottom: 15px;<br>&nbsp; &nbsp; border: 1px solid var(--gold);<br>}</p><p>header h1 {<br>&nbsp; &nbsp; margin: 10px 0;<br>&nbsp; &nbsp; font-size: 26px;<br>&nbsp; &nbsp; color: var(--gold);<br>}</p><p>header p {<br>&nbsp; &nbsp; color: #cbd5e1;<br>&nbsp; &nbsp; font-size: 14px;<br>}</p><p>main {<br>&nbsp; &nbsp; flex: 1;<br>&nbsp; &nbsp; max-width: 1000px;<br>&nbsp; &nbsp; width: 100%;<br>&nbsp; &nbsp; margin: 0 auto;<br>&nbsp; &nbsp; padding: 20px;<br>}</p><p>.passport-status, .stats-section {<br>&nbsp; &nbsp; margin-bottom: 25px;<br>}</p><p>.card, .stats-card {<br>&nbsp; &nbsp; background:var(--card-bg);mso-highlight:var(--card-bg);<br>&nbsp; &nbsp; border: 1px solid var(--gold);<br>&nbsp; &nbsp; border-radius: 12px;<br>&nbsp; &nbsp; padding: 20px;<br>&nbsp; &nbsp; box-shadow: 0 8px 20px rgba(0,0,0,0.3);<br>&nbsp; &nbsp; text-align: center;<br>}</p><p>.card h3, .stats-card h3 {<br>&nbsp; &nbsp; color: var(--gold);<br>&nbsp; &nbsp; margin-top: 0;<br>&nbsp; &nbsp; font-size: 18px;<br>}</p><p>.game-stats-row {<br>&nbsp; &nbsp; display: flex;<br>&nbsp; &nbsp; justify-content: space-around;<br>&nbsp; &nbsp; font-weight: bold;<br>&nbsp; &nbsp; color: var(--gold);<br>&nbsp; &nbsp; margin: 10px 0;<br>}</p><p>.stats-grid {<br>&nbsp; &nbsp; display: grid;<br>&nbsp; &nbsp; grid-template-columns: repeat(3, 1fr);<br>&nbsp; &nbsp; gap: 10px;<br>&nbsp; &nbsp; margin-top: 15px;<br>}</p><p>.stat-item {<br>&nbsp; &nbsp; background: #0c182b;<br>&nbsp; &nbsp; padding: 10px;<br>&nbsp; &nbsp; border-radius: 8px;<br>&nbsp; &nbsp; border: 1px solid #2a4365;<br>}</p><p>.stat-num {<br>&nbsp; &nbsp; display: block;<br>&nbsp; &nbsp; font-size: 20px;<br>&nbsp; &nbsp; font-weight: bold;<br>&nbsp; &nbsp; color: var(--gold);<br>}</p><p>.stat-label {<br>&nbsp; &nbsp; font-size: 11px;<br>&nbsp; &nbsp; color: #94a3b8;<br>}</p><p>.progress-bar {<br>&nbsp; &nbsp; width: 100%;<br>&nbsp; &nbsp; background:#0c182b;mso-highlight:#0c182b;<br>&nbsp; &nbsp; border-radius: 10px;<br>&nbsp; &nbsp; height: 14px;<br>&nbsp; &nbsp; overflow: hidden;<br>&nbsp; &nbsp; margin-top: 15px;<br>&nbsp; &nbsp; border: 1px solid #2a4365;<br>}</p><p>#progress-fill {<br>&nbsp; &nbsp; height: 100%;<br>&nbsp; &nbsp; background: linear-gradient(90deg, var(--terracotta), var(--gold));<br>&nbsp; &nbsp; transition: width 0.4s ease;<br>}</p><p>.regions-grid h2 {<br>&nbsp; &nbsp; text-align: center;<br>&nbsp; &nbsp; color: var(--gold);<br>&nbsp; &nbsp; margin-bottom: 20px;<br>&nbsp; &nbsp; font-size: 20px;<br>}</p><p>.grid-container {<br>&nbsp; &nbsp; display: grid;<br>&nbsp; &nbsp; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));<br>&nbsp; &nbsp; gap: 15px;<br>}</p><p>.region-card {<br>&nbsp; &nbsp; background:var(--card-bg);mso-highlight:var(--card-bg);<br>&nbsp; &nbsp; border: 1px solid #2a4365;<br>&nbsp; &nbsp; border-radius: 10px;<br>&nbsp; &nbsp; padding: 15px;<br>&nbsp; &nbsp; text-align: center;<br>&nbsp; &nbsp; cursor: pointer;<br>&nbsp; &nbsp; transition: all 0.3s ease;<br>}</p><p>.region-card:hover {<br>&nbsp; &nbsp; border-color: var(--gold);<br>&nbsp; &nbsp; transform: translateY(-3px);<br>}</p><p>.region-card.completed {<br>&nbsp; &nbsp; border-color: var(--terracotta);<br>&nbsp; &nbsp; background:#1a2636;mso-highlight:#1a2636;<br>}</p><p>.region-card.locked {<br>&nbsp; &nbsp; opacity: 0.5;<br>&nbsp; &nbsp; cursor: not-allowed;<br>&nbsp; &nbsp; border-style: dashed;<br>}</p><p>.region-card.locked:hover {<br>&nbsp; &nbsp; transform: none;<br>&nbsp; &nbsp; border-color: #2a4365;<br>}</p><p>.region-card h4 {<br>&nbsp; &nbsp; margin: 0 0 5px 0;<br>&nbsp; &nbsp; color: var(--text-light);<br>&nbsp; &nbsp; font-size: 16px;<br>}</p><p>.region-card span {<br>&nbsp; &nbsp; font-size: 12px;<br>&nbsp; &nbsp; color: var(--gold);<br>}</p><p>.modal {<br>&nbsp; &nbsp; display: none;<br>&nbsp; &nbsp; position: fixed;<br>&nbsp; &nbsp; z-index: 100;<br>&nbsp; &nbsp; left: 0;<br>&nbsp; &nbsp; top: 0;<br>&nbsp; &nbsp; width: 100%;<br>&nbsp; &nbsp; height: 100%;<br>&nbsp; &nbsp; background:rgba(12, 24, 43, 0.85);mso-highlight:rgba(12, 24, 43, 0.85);<br>&nbsp; &nbsp; backdrop-filter: blur(5px);<br>&nbsp; &nbsp; justify-content: center;<br>&nbsp; &nbsp; align-items: center;<br>}</p><p>.modal-content {<br>&nbsp; &nbsp; background:var(--card-bg);mso-highlight:var(--card-bg);<br>&nbsp; &nbsp; border: 2px solid var(--gold);<br>&nbsp; &nbsp; padding: 25px;<br>&nbsp; &nbsp; border-radius: 15px;<br>&nbsp; &nbsp; width: 90%;<br>&nbsp; &nbsp; max-width: 420px;<br>&nbsp; &nbsp; position: relative;<br>&nbsp; &nbsp; box-shadow: 0 10px 30px rgba(0,0,0,0.5);<br>}</p><p>.timer-box {<br>&nbsp; &nbsp; background: #08101d;<br>&nbsp; &nbsp; color: var(--gold);<br>&nbsp; &nbsp; padding: 6px 12px;<br>&nbsp; &nbsp; border-radius: 6px;<br>&nbsp; &nbsp; text-align: center;<br>&nbsp; &nbsp; font-weight: bold;<br>&nbsp; &nbsp; margin-bottom: 12px;<br>&nbsp; &nbsp; border: 1px solid #2a4365;<br>&nbsp; &nbsp; display: none;<br>}</p><p>.close-btn {<br>&nbsp; &nbsp; position: absolute;<br>&nbsp; &nbsp; right: 15px;<br>&nbsp; &nbsp; top: 10px;<br>&nbsp; &nbsp; font-size: 26px;<br>&nbsp; &nbsp; color: var(--text-light);<br>&nbsp; &nbsp; cursor: pointer;<br>}</p><p>.quiz-box {<br>&nbsp; &nbsp; margin-top: 15px;<br>&nbsp; &nbsp; background: #0c182b;<br>&nbsp; &nbsp; padding: 15px;<br>&nbsp; &nbsp; border-radius: 8px;<br>&nbsp; &nbsp; border: 1px solid #2a4365;<br>}</p><p>.quiz-box h4 {<br>&nbsp; &nbsp; color: var(--gold);<br>&nbsp; &nbsp; margin-top: 0;<br>&nbsp; &nbsp; font-size: 15px;<br>}</p><p>.quiz-option {<br>&nbsp; &nbsp; background: #1a3052;<br>&nbsp; &nbsp; color: #f5f2ec;<br>&nbsp; &nbsp; border: 1px solid #2a4365;<br>&nbsp; &nbsp; padding: 10px;<br>&nbsp; &nbsp; margin: 8px 0;<br>&nbsp; &nbsp; border-radius: 6px;<br>&nbsp; &nbsp; cursor: pointer;<br>&nbsp; &nbsp; width: 100%;<br>&nbsp; &nbsp; text-align: left;<br>&nbsp; &nbsp; font-size: 14px;<br>&nbsp; &nbsp; transition: background 0.2s;<br>}</p><p>.quiz-option:hover {<br>&nbsp; &nbsp; background: var(--terracotta);<br>&nbsp; &nbsp; border-color: var(--gold);<br>}</p><p>footer {<br>&nbsp; &nbsp; text-align: center;<br>&nbsp; &nbsp; padding: 15px;<br>&nbsp; &nbsp; background:#08101d;mso-highlight:#08101d;<br>&nbsp; &nbsp; color: #8892b0;<br>&nbsp; &nbsp; font-size: 12px;<br>&nbsp; &nbsp; border-top: 1px solid #1a3052;<br>}</p></div></body></html>
--NEXT.ITEM-BOUNDARY--