<body><div style="font-family:Calibri,sans-serif;font-size:11pt;"><p>const regions = [<br>&nbsp; &nbsp; {&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; id: 1, name: "Շիրակ",&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; desc: "Շիրակը Հայաստանի հյուսիսարևմտյան դարպասն է, որը հայտնի է իր խստաշունչ ձմեռներով, սև տուֆակերտ ճարտարապետությամբ և հսկայական ոսկեգույն հացահատիկային արտերով: Մարզկենտրոնը Գյումրին է:",<br>&nbsp; &nbsp; &nbsp; &nbsp; questions: [<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ինչպիսի՞ հացահատիկային արտերով և ձմեռներով է հայտնի Շիրակի մարզը։", options: ["Ոսկեգույն հացահատիկային և խստաշունչ ձմեռներով", "Արևադարձային և մեղմ", "Անապատային"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ո՞րն է Շիրակի մարզկենտրոն քաղաքը տեքստի համաձայն։", options: ["Գյումրի", "Վանաձոր", "Արթիկ"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ի՞նչ գույნის տուֆակերտ ճարտարապետությամբ է առանձնանում այս մարզը։", options: ["Սև տուֆով", "Սպիտակ մարմարով", "Կարմիր կավով"], correct: 0 }<br>&nbsp; &nbsp; &nbsp; &nbsp; ],<br>&nbsp; &nbsp; &nbsp; &nbsp; completed: false, unlocked: true&nbsp;<br>&nbsp; &nbsp; },<br>&nbsp; &nbsp; {&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; id: 2, name: "Լոռի",&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; desc: "Լոռին Հայաստանի ամենականաչ և անտառաշատ մարզերից է՝ կտրված խորը կիրճերով, որոնցով հոսում են արագահոս գետերը (օրինակ՝ Դեբեդը): Այն հարուստ է նաև լոբազգի մշակաբույսերով:",<br>&nbsp; &nbsp; &nbsp; &nbsp; questions: [<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ինչպիսի՞ն է Լոռվա բնությունը տեքստի նկարագրության համաձայն։", options: ["Ամենականաչ և անտառաշատ", "Անապատային ու չորային", "Տափաստանային"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ո՞ր գետն է հիշատակված որպես մարզով հոսող արագահոս գետ։", options: ["Դեբեդ", "Արաքս", "Հրազդան"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ինչպիսի՞ մշակաբույսերով է հարուստ Լոռին ըստ տեքստի։", options: ["Լոբազգի մշակաբույսերով", "Բրնձով", "Ձիթապտղով"], correct: 0 }<br>&nbsp; &nbsp; &nbsp; &nbsp; ],<br>&nbsp; &nbsp; &nbsp; &nbsp; completed: false, unlocked: false&nbsp;<br>&nbsp; &nbsp; },<br>&nbsp; &nbsp; {&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; id: 3, name: "Տավուշ",&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; desc: "Տավուշը հաճախ անվանում են հայկական շվեյցարիա։ Մարզը պատված է խիտ անտառներով, բլուրներով և հարուստ է վայրի մեղրատու բույսերով ու բնական աղբյուրներով:",<br>&nbsp; &nbsp; &nbsp; &nbsp; questions: [<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ի՞նչ անունով են հաճախ անվանում Տավուշի մարզը։", options: ["Հայկական շվեյցարիա", "Արարատյան դաշտ", "Սևանի ավազան"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ինչպիսի՞ բույսերով և աղբյուրներով է հարուստ մարզը ըստ նկարագրության։", options: ["Վայրի մեղրատու բույսերով և բնական աղբյուրներով", "Արևադարձային ծաղիկներով", "Անտառային սնկերով միայն"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ինչպիսի՞ն է մարզի մակերևույթը տեքստի համաձայն։", options: ["Պատված է խիտ անտառներով և բլուրներով", "Բացառապես հարթավայրային", "Քարքարոտ անապատ"], correct: 0 }<br>&nbsp; &nbsp; &nbsp; &nbsp; ],<br>&nbsp; &nbsp; &nbsp; &nbsp; completed: false, unlocked: false&nbsp;<br>&nbsp; &nbsp; },<br>&nbsp; &nbsp; {&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; id: 4, name: "Արագածոտն",&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; desc: "Արագածոտնը տարածվում է Հայաստանի ամենաբարձր լեռան՝ Արագածի լանջերին։ Մարզի բարձրադիր գոտիներն ունեն յուրահատուկ կլիմա և հարմար են կարտոֆիլի ու լեռնային կուլտուրաների համար:",<br>&nbsp; &nbsp; &nbsp; &nbsp; questions: [<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ո՞ր լեռան լանջերին է տարածվում Արագածոտնի մարզը։", options: ["Արագած", "Արարատ", "Խուստուփ"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ո՞րն է բարձրադիր գոտիների համար նշված գլխավոր մշակաբույսը տեքստում։", options: ["Կարտոֆիլ", "Բրինձ", "Լոլիկ"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ինչպիսի՞ կլիմա ունեն մարզի բարձրադիր գոտիները ըստ նկարագրության։", options: ["Յուրահատուկ կլիմա", "Խիստ արևադարձային", "Տաք և խոնավ"], correct: 0 }<br>&nbsp; &nbsp; &nbsp; &nbsp; ],<br>&nbsp; &nbsp; &nbsp; &nbsp; completed: false, unlocked: false&nbsp;<br>&nbsp; &nbsp; },<br>&nbsp; &nbsp; {&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; id: 5, name: "Կոտայք",&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; desc: "Կոտայքի մարզը գտնվում է երկրի սրտում։ Այն հայտնի է ինչպես բազմաթիվ առողջարաններով, այնպես էլ լեռնային մեղրի արտադրությամբ և հնագույն հուշարձաններով:",<br>&nbsp; &nbsp; &nbsp; &nbsp; questions: [<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Որտեղի՞ն է գտնվում Կոտայքի մարզը ըստ նկարագրության։", options: ["Երկրի սրտում", "Ծայր հյուսիսում", "Հարավային սահմանին"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ի՞նչ արտադրությամբ է հայտնի Կոտայքը տեքստի համաձայն։", options: ["Լեռնային մեղրի արտադրությամբ", "Ձկնաբուծությամբ", "Բրնձի մշակությամբ"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Բացի առողջարաններից, ինչո՞վ է դեռ հայտնի մարզը։", options: ["Հնագույն հուշարձաններով", "Ժամանակակից երկնաքերերով", "Մեծ նավահանգիստներով"], correct: 0 }<br>&nbsp; &nbsp; &nbsp; &nbsp; ],<br>&nbsp; &nbsp; &nbsp; &nbsp; completed: false, unlocked: false&nbsp;<br>&nbsp; &nbsp; },<br>&nbsp; &nbsp; {&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; id: 6, name: "Գեղարքունիք",&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; desc: "Գեղարքունիքը շրջապատում է հայոց կապույտ մարգարիտը՝ Սևանա լիճը։ Մարզի հողերը հարուստ են կարտոֆիլով, իսկ լիճը՝ յուրահատուկ ձկնատեսակներով:",<br>&nbsp; &nbsp; &nbsp; &nbsp; questions: [<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ինչպե՞ս է անվանում մարզը շրջապատող հայոց կապույտ մարգարիտը տեքստում։", options: ["Սևանա լիճ", "Արփա լիճ", "Վանա լիճ"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ի՞նչ բանջարեղենով են հարուստ մարզի հողերը ըստ նկարագրության։", options: ["Կարտոֆիլով", "Լոլիկով", "Վարունգով"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ինչո՞վ է հարուստ լիճը տեքստի համաձայն։", options: ["Յուրահատուկ ձկնատեսակներով", "Հանքային ջրերով", "Աղի բյուրեղներով"], correct: 0 }<br>&nbsp; &nbsp; &nbsp; &nbsp; ],<br>&nbsp; &nbsp; &nbsp; &nbsp; completed: false, unlocked: false&nbsp;<br>&nbsp; &nbsp; },<br>&nbsp; &nbsp; {&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; id: 7, name: "Արմավիր",&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; desc: "Արմավիրը տեղակայված է Արարատյան դաշտի սրտում։ Ունի շատ արևոտ օրեր, ջրառատ գետեր և հարուստ է խաղողի այգիներով ու բրնձի դաշտերով:",<br>&nbsp; &nbsp; &nbsp; &nbsp; questions: [<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Որտե՞ղ է տեղակայված Արմավիրի մարզը ըստ նկարագրության։", options: ["Արարատյան դաշտի սրտում", "Լեռնային Ղարաբաղում", "Շիրակի դաշտավարությունում"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ինչպիսի՞ այգիներով է հարուստ մարզը տեքստի համաձայն։", options: ["Խաղողի այգիներով", "Խնձորի այգիներով", "Նռան այգիներով"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Բացի խաղողից, ի՞նչ դաշտերով է հայտնի Արմավիրը։", options: ["Բրնձի դաշտերով", "Ցորենի արտերով", "Վուշի դաշտերով"], correct: 0 }<br>&nbsp; &nbsp; &nbsp; &nbsp; ],<br>&nbsp; &nbsp; &nbsp; &nbsp; completed: false, unlocked: false&nbsp;<br>&nbsp; &nbsp; },<br>&nbsp; &nbsp; {&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; id: 8, name: "Արարատ",&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; desc: "Արարատի մարզը ձգվում է Արարատյան դաշտի հարավային մասով։ Այն երկրի գյուղատնտեսական գլխավոր կենտրոններից է՝ հայտնի բանջարեղենով և հատկապես հյութեղ լոլիկով:",<br>&nbsp; &nbsp; &nbsp; &nbsp; questions: [<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Արարատյան դաշտի ո՞ր մասով է ձգվում Արարատի մարզը։", options: ["Հարավային մասով", "Հյուսիսային մասով", "Արևելյան մասով"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ինչպիսի՞ գյուղատնտեսական կենտրոն է հանդիսանում մարզը ըստ նկարագրության։", options: ["Գլխավոր կենտրոններից մեկը", "Երկրորդական նշանակության", "Միայն անասնապահական"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Հատկապես ի՞նչ հյութեղ բանջարեղենով է հայտնի մարզը տեքստում։", options: ["Լոլիկով", "Վարունգով", "Բիբարով"], correct: 0 }<br>&nbsp; &nbsp; &nbsp; &nbsp; ],<br>&nbsp; &nbsp; &nbsp; &nbsp; completed: false, unlocked: false&nbsp;<br>&nbsp; &nbsp; },<br>&nbsp; &nbsp; {&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; id: 9, name: "Վայոց Ձոր",&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; desc: "Վայոց Ձորը լեռնային, կիրճերով հարուստ մարզ է, որը համարվում է հայկական հնագույն գինեգործության բնօրրանը։ Այստեղ է գտնվում հայտնի Արենի քարանձավը:",<br>&nbsp; &nbsp; &nbsp; &nbsp; questions: [<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ինչպիսի՞ն է Վայոց Ձորի մակերևույթը ըստ նկարագրության։", options: ["Լեռնային, կիրճերով հարուստ", "Բացառապես հարթավայրային", "Անտառապատ դաշտավարություն"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ինչի՞ բնօրրան է համարվում այս մարզը տեքստի համաձայն։", options: ["Հայկական հնագույն գինեգործության", "Բրնձի արտադրության", "Թռչնաբուծության"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ո՞ր հայտնի քարանձավն է գտնվում Վայոց Ձորում ըստ նկարագրության։", options: ["Արենի քարանձավը", "Մագելի քարանձավը", "Ձիթհանքի քարանձավը"], correct: 0 }<br>&nbsp; &nbsp; &nbsp; &nbsp; ],<br>&nbsp; &nbsp; &nbsp; &nbsp; completed: false, unlocked: false&nbsp;<br>&nbsp; &nbsp; },<br>&nbsp; &nbsp; {&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; id: 10, name: "Սյունիք",&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; desc: "Սյունիքը Հայաստանի հարավային անառիկ դարպասն է՝ խորը կիրճերով, հզոր լեռներով, անտառներով և հարուստ ընկուզենու այգիներով:",<br>&nbsp; &nbsp; &nbsp; &nbsp; questions: [<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Հայաստանի ո՞ր դարպասն է համարվում Սյունիքը ըստ նկարագրության։", options: ["Հարավային անառիկ դարպասը", "Հյուսիսային արևոտ դարպասը", "Արևելյան մուտքը"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ինչպիսի՞ այգիներով է հարուստ Սյունիքը տեքստի համաձայն։", options: ["Ընկուզենու այգիներով", "Ծիրանի այգիներով", "Խնձորի այգիներով"], correct: 0 },<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; { q: "Ի՞նչ բնական տարրերով է բնութագրվում Սյունիքի մարզը տեքստում։", options: ["Խորը կիրճերով, հզոր լեռներով և անտառներով", "Անապատներով և ավազուտներով", "Լճերով և ճահիճներով"], correct: 0 }<br>&nbsp; &nbsp; &nbsp; &nbsp; ],<br>&nbsp; &nbsp; &nbsp; &nbsp; completed: false, unlocked: false&nbsp;<br>&nbsp; &nbsp; }<br>];</p><p>let currentRegion = null;<br>let currentStep = "desc";<br>let score = 0;<br>let globalStampsCount = 8930;<br>let timerInterval = null;<br>let timeLeft = 30; // Սահմանված է 30 վայրկյան</p><p>const container = document.getElementById("regions-container");<br>const modal = document.getElementById("modal");<br>const modalTitle = document.getElementById("modal-title");<br>const modalDesc = document.getElementById("modal-desc");<br>const closeModal = document.getElementById("close-modal");<br>const quizQuestion = document.getElementById("quiz-question");<br>const quizOptions = document.getElementById("quiz-options");<br>const progressCount = document.getElementById("progress-count");<br>const progressFill = document.getElementById("progress-fill");<br>const scoreCountEl = document.getElementById("score-count");<br>const globalStampsEl = document.getElementById("global-stamps");<br>const timerBox = document.getElementById("timer-box");<br>const timeLeftEl = document.getElementById("time-left");</p><p>function renderRegions() {<br>&nbsp; &nbsp; container.innerHTML = "";<br>&nbsp; &nbsp; let completedCount = 0;</p><p>&nbsp; &nbsp; regions.forEach((region, index) =&gt; {<br>&nbsp; &nbsp; &nbsp; &nbsp; if (region.completed) completedCount++;</p><p>&nbsp; &nbsp; &nbsp; &nbsp; const card = document.createElement("div");<br>&nbsp; &nbsp; &nbsp; &nbsp; let cardClass = "";<br>&nbsp; &nbsp; &nbsp; &nbsp; if (region.completed) cardClass = "completed";<br>&nbsp; &nbsp; &nbsp; &nbsp; else if (!region.unlocked) cardClass = "locked";</p><p>&nbsp; &nbsp; &nbsp; &nbsp; card.className = `region-card ${cardClass}`;<br>&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; let statusText = "📖 Բացել մարզը";<br>&nbsp; &nbsp; &nbsp; &nbsp; if (region.completed) statusText = "✅ Անցած է";<br>&nbsp; &nbsp; &nbsp; &nbsp; else if (!region.unlocked) statusText = "🔒 Արգելափակված է";</p><p>&nbsp; &nbsp; &nbsp; &nbsp; card.innerHTML = `<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h4&gt;${region.name}&lt;/h4&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;span&gt;${statusText}&lt;/span&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; `;<br>&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; card.addEventListener("click", () =&gt; {<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (region.unlocked || region.completed) {<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; openModal(region);<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; } else {<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; alert("🔒 Այս մարզը դեռ արգելափակված է։ Նախ անցեք նախորդ մարզի քվեստը։");<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }<br>&nbsp; &nbsp; &nbsp; &nbsp; });<br>&nbsp; &nbsp; &nbsp; &nbsp; container.appendChild(card);<br>&nbsp; &nbsp; });</p><p>&nbsp; &nbsp; progressCount.textContent = completedCount;<br>&nbsp; &nbsp; progressFill.style.width = `${(completedCount / 10) * 100}%`;<br>&nbsp; &nbsp; scoreCountEl.textContent = score;<br>&nbsp; &nbsp; globalStampsEl.textContent = globalStampsCount;<br>}</p><p>function openModal(region) {<br>&nbsp; &nbsp; currentRegion = region;<br>&nbsp; &nbsp; currentStep = "desc";<br>&nbsp; &nbsp; modalTitle.textContent = region.name + " Մարզ";<br>&nbsp; &nbsp; timerBox.style.display = "none";<br>&nbsp; &nbsp; updateModalContent();<br>&nbsp; &nbsp; modal.style.display = "flex";<br>}</p><p>function startTimer() {<br>&nbsp; &nbsp; clearInterval(timerInterval);<br>&nbsp; &nbsp; timeLeft = 30;<br>&nbsp; &nbsp; timeLeftEl.textContent = timeLeft;<br>&nbsp; &nbsp; timerBox.style.display = "block";</p><p>&nbsp; &nbsp; timerInterval = setInterval(() =&gt; {<br>&nbsp; &nbsp; &nbsp; &nbsp; timeLeft--;<br>&nbsp; &nbsp; &nbsp; &nbsp; timeLeftEl.textContent = timeLeft;<br>&nbsp; &nbsp; &nbsp; &nbsp; if (timeLeft &lt;= 0) {<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; clearInterval(timerInterval);<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; alert("⏰ Ժամանակն ավարտվեց! Փորձեք կրկին։");<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; modal.style.display = "none";<br>&nbsp; &nbsp; &nbsp; &nbsp; }<br>&nbsp; &nbsp; }, 1000);<br>}</p><p>function updateModalContent() {<br>&nbsp; &nbsp; quizOptions.innerHTML = "";</p><p>&nbsp; &nbsp; if (currentRegion.completed) {<br>&nbsp; &nbsp; &nbsp; &nbsp; timerBox.style.display = "none";<br>&nbsp; &nbsp; &nbsp; &nbsp; modalDesc.style.display = "block";<br>&nbsp; &nbsp; &nbsp; &nbsp; modalDesc.textContent = currentRegion.desc;<br>&nbsp; &nbsp; &nbsp; &nbsp; quizQuestion.textContent = "🎉 Այս մարզի բոլոր հարցերը հաջողությամբ պատասխանված են, և կնիքը ստացված է։";<br>&nbsp; &nbsp; &nbsp; &nbsp; return;<br>&nbsp; &nbsp; }</p><p>&nbsp; &nbsp; if (currentStep === "desc") {<br>&nbsp; &nbsp; &nbsp; &nbsp; timerBox.style.display = "none";<br>&nbsp; &nbsp; &nbsp; &nbsp; modalDesc.style.display = "block";<br>&nbsp; &nbsp; &nbsp; &nbsp; modalDesc.textContent = currentRegion.desc;<br>&nbsp; &nbsp; &nbsp; &nbsp; quizQuestion.textContent = "Ծանոթացա՞ք մարզի նկարագրությանը:";<br>&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; const startBtn = document.createElement("button");<br>&nbsp; &nbsp; &nbsp; &nbsp; startBtn.className = "quiz-option";<br>&nbsp; &nbsp; &nbsp; &nbsp; startBtn.style.textAlign = "center";<br>&nbsp; &nbsp; &nbsp; &nbsp; startBtn.style.fontWeight = "bold";<br>&nbsp; &nbsp; &nbsp; &nbsp; startBtn.style.background = "var(--terracotta)";<br>&nbsp; &nbsp; &nbsp; &nbsp; startBtn.textContent = "🎯 Սկսել Քվեստը (30վրկ)";<br>&nbsp; &nbsp; &nbsp; &nbsp; startBtn.addEventListener("click", () =&gt; {<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; currentStep = 0;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; startTimer();<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; updateModalContent();<br>&nbsp; &nbsp; &nbsp; &nbsp; });<br>&nbsp; &nbsp; &nbsp; &nbsp; quizOptions.appendChild(startBtn);</p><p>&nbsp; &nbsp; } else {<br>&nbsp; &nbsp; &nbsp; &nbsp; modalDesc.style.display = "none";<br>&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<br>&nbsp; &nbsp; &nbsp; &nbsp; const qData = currentRegion.questions[currentStep];<br>&nbsp; &nbsp; &nbsp; &nbsp; quizQuestion.textContent = `Հարց ${currentStep + 1} / 3: ${qData.q}`;</p><p>&nbsp; &nbsp; &nbsp; &nbsp; qData.options.forEach((opt, index) =&gt; {<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const btn = document.createElement("button");<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; btn.className = "quiz-option";<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; btn.textContent = opt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; btn.addEventListener("click", () =&gt; checkAnswer(index));<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; quizOptions.appendChild(btn);<br>&nbsp; &nbsp; &nbsp; &nbsp; });<br>&nbsp; &nbsp; }<br>}</p><p>function checkAnswer(selectedIndex) {<br>&nbsp; &nbsp; const qData = currentRegion.questions[currentStep];</p><p>&nbsp; &nbsp; if (selectedIndex === qData.correct) {<br>&nbsp; &nbsp; &nbsp; &nbsp; score += 10;<br>&nbsp; &nbsp; &nbsp; &nbsp; currentStep++;<br>&nbsp; &nbsp; &nbsp; &nbsp; if (currentStep &lt; currentRegion.questions.length) {<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; updateModalContent();<br>&nbsp; &nbsp; &nbsp; &nbsp; } else {<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; clearInterval(timerInterval);<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; currentRegion.completed = true;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; globalStampsCount += 3;</p><p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const currentIndex = regions.findIndex(r =&gt; r.id === currentRegion.id);<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (currentIndex &lt; regions.length - 1) {<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; regions[currentIndex + 1].unlocked = true;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</p><p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; renderRegions();<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; modal.style.display = "none";<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; alert(`🎉 Հիանալի է! Դուք հավաքեցիք +30 միավոր և ստացաք ${currentRegion.name} մարզի կնիքը։ Հաջորդ մարզը բացված է։`);<br>&nbsp; &nbsp; &nbsp; &nbsp; }<br>&nbsp; &nbsp; } else {<br>&nbsp; &nbsp; &nbsp; &nbsp; score = Math.max(0, score - 5);<br>&nbsp; &nbsp; &nbsp; &nbsp; scoreCountEl.textContent = score;<br>&nbsp; &nbsp; &nbsp; &nbsp; alert("❌ Սխալ պատասխան է (-5 միավոր)։ Փորձեք կրկին։");<br>&nbsp; &nbsp; }<br>}</p><p>closeModal.addEventListener("click", () =&gt; {<br>&nbsp; &nbsp; clearInterval(timerInterval);<br>&nbsp; &nbsp; modal.style.display = "none";<br>});</p><p>renderRegions();</p></div></body></html>
--NEXT.ITEM-BOUNDARY--